{
	"name": "@jellyfin/vega",
	"version": "0.0.1",
	"private": true,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "npm-run-all build:release",
		"build:app": "npm-run-all build:release",
		"build:debug": "react-native build-vega --build-type Debug",
		"build:release": "react-native build-vega --build-type Release",
		"clean": "rm -rf node_modules buildinfo.json dist build",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --check . --ignore-path .gitignore",
		"format:fix": "prettier --write . --ignore-path .gitignore",
		"release": "npm-run-all lint test build:app",
		"start": "react-native start"
	},
	"overrides": {
		"react": "19.3.1",
		"react-native": "0.88.1"
	},
	"dependencies": {
		"@amazon-devices/asset-resolver-lib": "1.0.1767254404",
		"@amazon-devices/react-native-async-storage__async-storage": "2.1.9000000002",
		"@amazon-devices/react-native-kepler": "4.0.2",
		"@amazon-devices/webview": "4.0.5",
		"@jellyfin/sdk": "1.0.2",
		"react": "19.3.1",
		"react-native": "0.88.1",
		"whatwg-url-without-unicode": "8.0.0-3"
	},
	"devDependencies": {
		"@amazon-devices/eslint-plugin-kepler": "0.1.16",
		"@amazon-devices/kepler-cli-platform": "0.22.14",
		"@eslint/js": "9.39.5",
		"@react-native-community/cli": "20.2.0",
		"@react-native/babel-preset": "0.83.0",
		"@react-native/eslint-config": "0.88.1",
		"@react-native/metro-config": "0.83.0",
		"@testing-library/react-native": "14.1.0",
		"@types/react": "19.2.18",
		"@types/react-test-renderer": "19.3.1",
		"@typescript-eslint/eslint-plugin": "8.72.2",
		"@typescript-eslint/parser": "8.72.2",
		"eslint": "9.39.5",
		"eslint-plugin-jest": "29.17.0",
		"jsonc-eslint-parser": "3.3.0",
		"npm-run-all2": "9.0.4",
		"prettier": "3.9.10",
		"react-test-renderer": "19.3.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"kepler": {
		"projectType": "application",
		"appName": "Jellyfin",
		"targets": [
			"tv"
		]
	}
}
